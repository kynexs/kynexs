# Copy this file to `.env` and replace the placeholders with your real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Neon Object Storage. The AWS SDK reads these names; S3_BUCKET_NAME is the bucket.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
AWS_ENDPOINT_URL_S3=""
S3_BUCKET_NAME=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional site config
NEXT_PUBLIC_SITE_URL="https://kynexs.com"
NEXT_PUBLIC_LAUNCH_DATE="2026-11-22T18:00:00+05:00"
